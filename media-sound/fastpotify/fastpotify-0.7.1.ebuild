inherit cargo desktop xdg

COMMIT="67b8dfbb22f1d97a0eec359021f25cbcae8e5d69"

DESCRIPTION="Spotify, native and fast, a lightweight Rust client with local playback and Connect"
HOMEPAGE="https://github.com/crmne/fastpotify"
SRC_URI="
	https://github.com/crmne/fastpotify/archive/${COMMIT}.tar.gz -> ${P}-${COMMIT}.gh.tar.gz
	${CARGO_CRATE_URIS}
"
S="${WORKDIR}/${PN}-${COMMIT}"

LICENSE="MIT"
# Dependent crate licenses, union across the bundled crates
LICENSE+=" Apache-2.0 Boost-1.0 BSD BSD-2 CC0-1.0 ISC MIT MPL-2.0 Unicode-3.0 Unicode-DFS-2016 ZLIB"
SLOT="0"
KEYWORDS="~amd64"

DEPEND="
	media-libs/alsa-lib
	media-libs/libglvnd
	media-libs/libpulse
	dev-libs/wayland
	x11-libs/libX11
	x11-libs/libXcursor
	x11-libs/libXi
	x11-libs/libXrandr
	x11-libs/libxkbcommon
"
RDEPEND="${DEPEND}"
BDEPEND+=" virtual/pkgconfig"

QA_FLAGS_IGNORED="usr/bin/${PN}"

src_configure() {
	cargo_src_configure --no-default-features
}

src_install() {
	cargo_src_install
	domenu packaging/applications/fastpotify.desktop
	insinto /usr/share/icons/hicolor/scalable/apps
	newins packaging/icons/fastpotify.svg fastpotify.svg
	dodoc README.md
}
