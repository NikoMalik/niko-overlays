From 26888ea0c9a9115f9dc82e3eb8557525b5102068 Mon Sep 17 00:00:00 2001
From: NikoMalik <NikoMalik@users.noreply.github.com>
Date: Tue, 10 Nov 2026 22:52:53 +0300
Subject: [PATCH] sched/poc: enable target sticky by default

halves wakeup migrations of a cpu bound game main thread (35% -> 18%) and gives ~18% more wakeup cycles at the same cpu time
---
 kernel/sched/poc_selector.c | 8 ++++----
 kernel/sched/sched.h        | 2 +-
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/kernel/sched/poc_selector.c b/kernel/sched/poc_selector.c
index d0f1a4532fb6f..aade6083fccb9 100644
--- a/kernel/sched/poc_selector.c
+++ b/kernel/sched/poc_selector.c
@@ -130,9 +130,9 @@ DEFINE_STATIC_KEY_TRUE(sched_poc_smt_uniform);
  * it ran on last, keeping warm TLB/L1/L2 state.
  *
  * Checked after Level 0 (saturation) and before core_mask derivation.
- * Default: disabled.
+ * Default: enabled.
  */
-DEFINE_STATIC_KEY_FALSE(sched_poc_target_sticky);
+DEFINE_STATIC_KEY_TRUE(sched_poc_target_sticky);
 
 /*
  * Early select: sched_poc_early_select
@@ -1064,7 +1064,7 @@ static __always_inline int select_idle_cpu_poc(int target, int prev,
 			POC_RETURN(recent, POC_LV1R);
 
 		/* Level 1s: target CPU sticky — L1/TLB affinity shortcut */
-		if (static_branch_unlikely(&sched_poc_target_sticky) && POC_IDLE_CPU(tgt_bit))
+		if (static_branch_likely(&sched_poc_target_sticky) && POC_IDLE_CPU(tgt_bit))
 			POC_RETURN(target, POC_LV1S);
 
 		if (core_mask) {
@@ -1601,7 +1601,7 @@ static int sched_poc_target_sticky_sysctl_handler(const struct ctl_table *table,
 					       int write, void *buffer,
 					       size_t *lenp, loff_t *ppos)
 {
-	unsigned int val = static_branch_unlikely(&sched_poc_target_sticky) ? 1 : 0;
+	unsigned int val = static_branch_likely(&sched_poc_target_sticky) ? 1 : 0;
 	struct ctl_table tmp = {
 		.data    = &val,
 		.maxlen  = sizeof(val),
diff --git a/kernel/sched/sched.h b/kernel/sched/sched.h
index c48e38b3c697c..c59167be29535 100644
--- a/kernel/sched/sched.h
+++ b/kernel/sched/sched.h
@@ -2401,7 +2401,7 @@ static inline void poc_check_skip_fallback(void) {}
 extern struct static_key_true sched_poc_aligned;
 extern struct static_key_true sched_poc_smt_consecutive;
 extern struct static_key_true sched_poc_smt_uniform;
-extern struct static_key_false sched_poc_target_sticky;
+extern struct static_key_true sched_poc_target_sticky;
 extern struct static_key_true sched_poc_packed;
 extern struct static_key_false sched_poc_lockless_bitmap;
 extern void __set_cpu_idle_state_poc(int cpu, int state);
-- 
