diff --git a/Makefile b/Makefile
index ac74f779e..3a87d7add 100644
--- a/Makefile
+++ b/Makefile
@@ -933,10 +933,15 @@ ifdef CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE
 KBUILD_CFLAGS += -O2
 KBUILD_RUSTFLAGS += -Copt-level=2
 else ifdef CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3
+KBUILD_CFLAGS += $(call cc-option,-mllvm -enable-pipeliner)
+KBUILD_CFLAGS += $(call cc-option,-mllvm -unroll-threshold=512)
+KBUILD_CFLAGS += $(call cc-option,-mllvm -inline-threshold=1000)
+KBUILD_CFLAGS += $(call cc-option,-mllvm -unroll-runtime-multi-exit)
 KBUILD_CFLAGS += -O3
 KBUILD_RUSTFLAGS += -Copt-level=3
 else ifdef CONFIG_CC_OPTIMIZE_FOR_SIZE
 KBUILD_CFLAGS += -Os
+KBUILD_CFLAGS += $(call cc-option,-mllvm -enable-pipeliner-opt-size)
 KBUILD_RUSTFLAGS += -Copt-level=s
 endif
 

