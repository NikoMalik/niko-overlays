From 477cb55f4f4f1c24e06a1a63759b8178cbaa323a Mon Sep 17 00:00:00 2001
From: NikoMalik <NikoMalik@users.noreply.github.com>
Date: Sun, 22 Nov 2026 00:12:36 +0300
Subject: [PATCH] cpufreq: add reflex to the default governor choice

---
 drivers/cpufreq/Kconfig | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/drivers/cpufreq/Kconfig b/drivers/cpufreq/Kconfig
index db83f3365698..016c86f704f8 100644
--- a/drivers/cpufreq/Kconfig
+++ b/drivers/cpufreq/Kconfig
@@ -105,6 +105,16 @@ config CPU_FREQ_DEFAULT_GOV_SCHEDUTIL
 	  have a look at the help section of that governor. The fallback
 	  governor will be 'performance'.
 
+config CPU_FREQ_DEFAULT_GOV_REFLEX
+	bool "reflex"
+	depends on SMP
+	select CPU_FREQ_GOV_SCHEDUTIL
+	select CPU_FREQ_GOV_REFLEX
+	select CPU_FREQ_GOV_PERFORMANCE
+	help
+	  Use the 'reflex' CPUFreq governor by default, it is built in then.
+	  The fallback governor will be 'performance'.
+
 endchoice
 
 config CPU_FREQ_GOV_PERFORMANCE
-- 
2.56.1

