From 8b52d2021505cdc0b8b60e403fdc92125dc591b5 Mon Sep 17 00:00:00 2001
From: NikoMalik <NikoMalik@users.noreply.github.com>
Date: Tue, 20 Oct 2026 17:43:20 +0300
Subject: [PATCH] fair/bore: fixed climb,added climb limit to fork processes

---
 kernel/sched/bore.c | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/kernel/sched/bore.c b/kernel/sched/bore.c
index 9d75c476a..97313bead 100644
--- a/kernel/sched/bore.c
+++ b/kernel/sched/bore.c
@@ -29,6 +29,9 @@ static int __maybe_unused maxval_1_million = 1000000;
 #define MAX_BURST_PENALTY ((40U << 8) - 1)
 #define BURST_CACHE_SAMPLE_LIMIT 63
 #define BURST_CACHE_SCAN_LIMIT (BURST_CACHE_SAMPLE_LIMIT * 2)
+/* bound the ancestor hub walks, a deep single-child chain must not turn fork into O(depth) under rcu */
+#define BORE_HUB_CLIMB_LIMIT 64
+#define BORE_HUB_DESCEND_LIMIT 64
 
 static u32 bore_reciprocal_lut[BURST_CACHE_SAMPLE_LIMIT + 1];
 
@@ -236,15 +239,18 @@ static u32 inherit_from_ancestor_hub(struct task_struct *parent,
 	struct bore_bc bc_val;
 	struct task_struct *ancestor = parent;
 	u32 sole_child_count = 0;
+	u32 climb = 0;
 
 	if (clone_flags & CLONE_PARENT) {
 		ancestor = rcu_dereference(ancestor->real_parent);
 		sole_child_count = 1;
 	}
 
+	/* climb cap keeps the walk and the rcu read section bounded, an early stop only picks a less representative hub */
 	for (struct task_struct *next;
 			(next = rcu_dereference(ancestor->real_parent)) != ancestor &&
-			count_children_upto2(ancestor) <= sole_child_count;
+			count_children_upto2(ancestor) <= sole_child_count &&
+			climb++ < BORE_HUB_CLIMB_LIMIT;
 			ancestor = next, sole_child_count = 1) {}
 
 	struct bore_bc *bc = &ancestor->bore.subtree;
@@ -257,7 +263,10 @@ static u32 inherit_from_ancestor_hub(struct task_struct *parent,
 			if (scan_count++ >= BURST_CACHE_SCAN_LIMIT) break;
 
 			struct task_struct *descendant = direct_child;
-			while (count_children_upto2(descendant) == 1) {
+			u32 descend = 0;
+			/* same bound on the downward single-child chain */
+			while (count_children_upto2(descendant) == 1 &&
+			       descend++ < BORE_HUB_DESCEND_LIMIT) {
 				struct task_struct *next_descendant =
 					list_first_or_null_rcu(&descendant->children,
 											struct task_struct, sibling);
-- 
2.56.0


