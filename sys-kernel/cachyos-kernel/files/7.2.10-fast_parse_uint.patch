From 0a352462064cee4e25a520ec892fc60ff4b82033 Mon Sep 17 00:00:00 2001
From: NikoMalik <NikoMalik@users.noreply.github.com>
Date: Fri, 16 Oct 2026 23:44:22 +0300
Subject: [PATCH] lib/kstrtox/: faster impl with swar for parse 64 bit int

---
 lib/kstrtox.c | 73 +++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 73 insertions(+)

diff --git a/lib/kstrtox.c b/lib/kstrtox.c
index edc4eb7c1..436192041 100644
--- a/lib/kstrtox.c
+++ b/lib/kstrtox.c
@@ -17,7 +17,9 @@
 #include <linux/export.h>
 #include <linux/kstrtox.h>
 #include <linux/math64.h>
+#include <linux/string.h>
 #include <linux/types.h>
+#include <linux/unaligned.h>
 #include <linux/uaccess.h>
 
 #include "kstrtox.h"
@@ -120,6 +122,60 @@ static int _kstrtoull(const char *s, unsigned int base, unsigned long long *res)
 	return 0;
 }
 
+/* Parse a decimal string using eight-digit SWAR chunks when possible. */
+static inline bool parse_u64_decimal_fast(const char *s, u64 *res)
+{
+	const u64 digit_mask = 0x0f0f0f0f0f0f0f0fULL;
+	const u64 high_mask = 0xf0f0f0f0f0f0f0f0ULL;
+	const u64 low_pair_mask = 0x00ff00ff00ff00ffULL;
+	const u64 low_word_mask = 0x0000ffff0000ffffULL;
+	u64 value = 0;
+	unsigned int digits_count = 0;
+
+	while (strnlen(s, 8) == 8) {
+		u64 word = get_unaligned_le64(s);
+		u64 digits, lo, hi, chunk;
+
+		if (digits_count > 11)
+			return false;
+		if ((word & high_mask) != 0x3030303030303030ULL)
+			return false;
+		digits = word & digit_mask;
+		if (((digits + 0x0606060606060606ULL) & high_mask) != 0)
+			return false;
+
+		lo = digits & low_pair_mask;
+		hi = (digits >> 8) & low_pair_mask;
+		chunk = lo * 10 + hi;
+		lo = chunk & low_word_mask;
+		hi = (chunk >> 16) & low_word_mask;
+		chunk = lo * 100 + hi;
+		lo = chunk & 0x00000000ffffffffULL;
+		hi = chunk >> 32;
+		chunk = lo * 10000 + hi;
+
+		value = value * 100000000 + chunk;
+		digits_count += 8;
+		s += 8;
+	}
+
+	while (*s >= '0' && *s <= '9') {
+		if (digits_count == 19)
+			return false;
+		value = value * 10 + (*s++ - '0');
+		digits_count++;
+	}
+
+	if (!digits_count)
+		return false;
+	if (*s == '\n')
+		s++;
+	if (*s)
+		return false;
+	*res = value;
+	return true;
+}
+
 /**
  * kstrtoull - convert a string to an unsigned long long
  * @s: The start of the string. The string must be null-terminated, and may also
@@ -138,8 +194,15 @@ static int _kstrtoull(const char *s, unsigned int base, unsigned long long *res)
 noinline
 int kstrtoull(const char *s, unsigned int base, unsigned long long *res)
 {
+	u64 tmp;
+
 	if (s[0] == '+')
 		s++;
+	if ((base == 10 || (base == 0 && s[0] != '0')) &&
+	    parse_u64_decimal_fast(s, &tmp)) {
+		*res = tmp;
+		return 0;
+	}
 	return _kstrtoull(s, base, res);
 }
 EXPORT_SYMBOL(kstrtoull);
@@ -164,6 +227,16 @@ int kstrtoll(const char *s, unsigned int base, long long *res)
 {
 	unsigned long long tmp;
 	int rv;
+	bool negative = s[0] == '-';
+	const char *digits = s + (negative || s[0] == '+');
+	u64 neg_mask = 0 - (u64)negative;
+
+	if ((base == 10 || (base == 0 && digits[0] != '0')) &&
+	    parse_u64_decimal_fast(digits, &tmp) &&
+	    tmp <= (u64)S64_MAX + (u64)negative) {
+		*res = (s64)((tmp ^ neg_mask) - neg_mask);
+		return 0;
+	}
 
 	if (s[0] == '-') {
 		rv = _kstrtoull(s + 1, base, &tmp);
-- 
2.56.0


