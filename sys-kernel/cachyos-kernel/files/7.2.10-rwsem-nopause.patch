From 8581dcbcc5d5433e3cff282cbaacb37a42b31658 Mon Sep 17 00:00:00 2001
From: NikoMalik <NikoMalik@users.noreply.github.com>
Date: Mon, 16 Nov 2026 10:15:07 +0300
Subject: [PATCH] locking/rwsem: make the no-pause owner spin switchable

clear linux carried a patch that skips cpu_relax() for the first 1000
rounds of rwsem_spin_on_owner(),PAUSE takes about 140 cycles since skylake
so a spinner notices the owner's release that much later,but a spinner
without it also starves an SMT sibling that may be the owner

add it behind kernel.rwsem_spin_nopause,a static key that is off by
default,so both behaviours can be measured on one boot
---
 kernel/locking/rwsem.c | 35 ++++++++++++++++++++++++++++++++++-
 1 file changed, 34 insertions(+), 1 deletion(-)

diff --git a/kernel/locking/rwsem.c b/kernel/locking/rwsem.c
index b9c180ac1eee..389dfc646500 100644
--- a/kernel/locking/rwsem.c
+++ b/kernel/locking/rwsem.c
@@ -28,6 +28,8 @@
 #include <linux/rwsem.h>
 #include <linux/atomic.h>
 #include <linux/hung_task.h>
+#include <linux/jump_label.h>
+#include <linux/sysctl.h>
 #include <trace/events/lock.h>
 
 #ifndef CONFIG_PREEMPT_RT
@@ -707,6 +709,34 @@ enum owner_state {
 };
 
 #ifdef CONFIG_RWSEM_SPIN_ON_OWNER
+/*
+ * PAUSE takes about 140 cycles since Skylake, a spinner that runs
+ * cpu_relax() on every round notices the owner's release that much later.
+ * kernel.rwsem_spin_nopause=1 skips it for the first RWSEM_NOPAUSE_SPINS
+ * rounds of each owner, at the cost of starving an SMT sibling that may be
+ * the owner itself. Off by default so both can be measured on one boot.
+ */
+#define RWSEM_NOPAUSE_SPINS	1000
+
+static DEFINE_STATIC_KEY_FALSE(rwsem_spin_nopause);
+
+static const struct ctl_table rwsem_sysctl_table[] = {
+	{
+		.procname	= "rwsem_spin_nopause",
+		.data		= &rwsem_spin_nopause.key,
+		.maxlen		= sizeof(rwsem_spin_nopause),
+		.mode		= 0644,
+		.proc_handler	= proc_do_static_key,
+	},
+};
+
+static int __init rwsem_sysctl_init(void)
+{
+	register_sysctl_init("kernel", rwsem_sysctl_table);
+	return 0;
+}
+late_initcall(rwsem_sysctl_init);
+
 /*
  * Try to acquire write lock before the writer has been put on wait queue.
  */
@@ -770,6 +800,7 @@ rwsem_spin_on_owner(struct rw_semaphore *sem)
 	struct task_struct *new, *owner;
 	unsigned long flags, new_flags;
 	enum owner_state state;
+	unsigned int spins = 0;
 
 	lockdep_assert_preemption_disabled();
 
@@ -806,7 +837,9 @@ rwsem_spin_on_owner(struct rw_semaphore *sem)
 			break;
 		}
 
-		cpu_relax();
+		if (!static_branch_unlikely(&rwsem_spin_nopause) ||
+		    ++spins > RWSEM_NOPAUSE_SPINS)
+			cpu_relax();
 	}
 
 	return state;
-- 
2.56.1

