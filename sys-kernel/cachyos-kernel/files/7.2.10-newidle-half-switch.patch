From e72e9b52d520e9ba8bf17c54582d43c28d6fa744 Mon Sep 17 00:00:00 2001
From: NikoMalik <NikoMalik@users.noreply.github.com>
Date: Mon, 16 Nov 2026 17:01:07 +0300
Subject: [PATCH] sched/fair: make the half avg_idle newidle cutoff switchable

the better_idle cutoff stops newidle balance once the domain costs reach
half of avg_idle,put it behind kernel.sched_newidle_half_idle,a static
key that is on by default,so both cutoffs can be compared on one boot
---
 kernel/sched/fair.c | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index d7630e878159..18763f8f4852 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -155,8 +155,22 @@ static unsigned int sysctl_sched_cfs_bandwidth_slice		= 5000UL;
 static unsigned int sysctl_numa_balancing_promote_rate_limit = 65536;
 #endif
 
+/*
+ * Newidle balance stops once the domain costs reach half of avg_idle
+ * instead of all of it, so a CPU about to idle pulls tasks less often.
+ * kernel.sched_newidle_half_idle=0 brings back the upstream cutoff.
+ */
+static DEFINE_STATIC_KEY_TRUE(sched_newidle_half_idle);
+
 #ifdef CONFIG_SYSCTL
 static const struct ctl_table sched_fair_sysctls[] = {
+	{
+		.procname	= "sched_newidle_half_idle",
+		.data		= &sched_newidle_half_idle.key,
+		.maxlen		= sizeof(sched_newidle_half_idle),
+		.mode		= 0644,
+		.proc_handler	= proc_do_static_key,
+	},
 #ifdef CONFIG_CFS_BANDWIDTH
 	{
 		.procname       = "sched_cfs_bandwidth_slice_us",
@@ -15561,7 +15575,9 @@ static int sched_balance_newidle(struct rq *this_rq, struct rq_flags *rf)
 
 		update_next_balance(sd, &next_balance);
 
-		if (this_rq->avg_idle/2 < curr_cost + sd->max_newidle_lb_cost)
+		if ((static_branch_likely(&sched_newidle_half_idle) ?
+		     this_rq->avg_idle / 2 : this_rq->avg_idle) <
+		    curr_cost + sd->max_newidle_lb_cost)
 			break;
 
 		if (sd->flags & SD_BALANCE_NEWIDLE) {
-- 
2.56.1

