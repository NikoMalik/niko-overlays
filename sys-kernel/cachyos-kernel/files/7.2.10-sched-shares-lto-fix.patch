sched/fair: keep calc_*_shares symbols under ThinLTO

The cgroup-mode shares selectors are static functions referenced only as
DEFINE_STATIC_CALL(calc_group_shares, ...) default targets, whose static-call
trampolines reference them by symbol name in asm. Under ThinLTO they get
internalized/dropped, breaking the trampoline (undefined calc_concur_shares at
vmlinux link). Mark them __used (llvm.used) so LTO retains the symbols.

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index 763f23d45..b8faabaf3 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -5177,7 +5177,7 @@ static inline int tg_tasks(struct task_group *tg)
  *
  * Scale tg->shares by the number of tasks.
  */
-static long calc_tasks_shares(struct cfs_rq *cfs_rq)
+static long __used calc_tasks_shares(struct cfs_rq *cfs_rq)
 {
 	struct task_group *tg = cfs_rq->tg;
 	int nr = tg_tasks(tg);
@@ -5192,7 +5192,7 @@ static long calc_tasks_shares(struct cfs_rq *cfs_rq)
  * nice -20, otherwise a single spinner on a 512 CPU machine would result in
  * 512*NICE_0_LOAD, which is also crazy.
  */
-static long calc_max_shares(struct cfs_rq *cfs_rq)
+static long __used calc_max_shares(struct cfs_rq *cfs_rq)
 {
 	struct task_group *tg = cfs_rq->tg;
 	int nr = tg_cpus(tg);
@@ -5207,7 +5207,7 @@ static long calc_max_shares(struct cfs_rq *cfs_rq)
  * Scales between "smp" and "max" in a natural way. No longer needs clipping
  * since there are no unnatural inflations like with "max".
  */
-static long calc_concur_shares(struct cfs_rq *cfs_rq)
+static long __used calc_concur_shares(struct cfs_rq *cfs_rq)
 {
 	struct task_group *tg = cfs_rq->tg;
 	int nr = min(tg_tasks(tg), tg_cpus(tg));
@@ -5220,7 +5220,7 @@ static long calc_concur_shares(struct cfs_rq *cfs_rq)
  *
  * This infamously results in tiny shares when you have many CPUs.
  */
-static long calc_smp_shares(struct cfs_rq *cfs_rq)
+static long __used calc_smp_shares(struct cfs_rq *cfs_rq)
 {
 	struct task_group *tg = cfs_rq->tg;
 	long tg_shares = READ_ONCE(tg->shares);
@@ -5230,7 +5230,7 @@ static long calc_smp_shares(struct cfs_rq *cfs_rq)
 /*
  * Ignore this pesky SMP stuff, use (4).
  */
-static long calc_up_shares(struct cfs_rq *cfs_rq)
+static long __used calc_up_shares(struct cfs_rq *cfs_rq)
 {
 	struct task_group *tg = cfs_rq->tg;
 	return READ_ONCE(tg->shares);
