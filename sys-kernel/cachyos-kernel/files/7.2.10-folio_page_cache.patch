@@ -2631,6 +2631,7 @@ static enum scan_result collapse_file(struct mm_struct *mm, unsigned long addr,
 			lruvec_stat_mod_folio(folio, NR_SHMEM,
 					      -folio_nr_pages(folio));
 		folio->mapping = NULL;
