 	 * Drop cache reference from old folio by unfreezing
diff --git a/mm/page_alloc.c b/mm/page_alloc.c
index 40cc3b7b6..1018ae47c 100644
--- a/mm/page_alloc.c
+++ b/mm/page_alloc.c
@@ -1234,6 +1234,13 @@ static void clear_highpages_kasan_tagged(struct page *page, int numpages)
 
 #ifdef CONFIG_MEM_ALLOC_PROFILING
 
+
+
+
