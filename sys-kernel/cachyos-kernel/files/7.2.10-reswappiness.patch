From 0b641652d0764e6595ee8f6e24d74e179548568d Mon Sep 17 00:00:00 2001
From: NikoMalik <NikoMalik@users.noreply.github.com>
Date: Tue, 10 Nov 2026 19:28:03 +0300
Subject: [PATCH] mglru: keep anon and file aging at the same wall-clock pace

refault recency is counted in gens per type,when one type ages much faster its refaults stop counting and the ctrl keeps evicting it
---
 mm/vmscan.c | 17 ++++++++++++-----
 1 file changed, 12 insertions(+), 5 deletions(-)

diff --git a/mm/vmscan.c b/mm/vmscan.c
index f8b34965a221f..3bd1b450f2ad8 100644
--- a/mm/vmscan.c
+++ b/mm/vmscan.c
@@ -5154,13 +5154,20 @@ static bool try_to_shrink_lruvec(struct lruvec *lruvec, struct scan_control *sc)
 
 		if (should_run_aging(lruvec, max_seq, sc, swappiness)) {
 			/*
-			 * Per-type independent aging: only age the type that
-			 * actually needs it, so a type with enough evictable
-			 * gens is not forcibly drained while the other is
-			 * stuck (e.g. file cache protected by le9uo)
