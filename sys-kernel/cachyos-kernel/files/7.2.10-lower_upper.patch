From e32f73075642f3e5db01cf5cd4257ccc83768440 Mon Sep 17 00:00:00 2001
From: NikoMalik <NikoMalik@users.noreply.github.com>
Date: Sat, 17 Oct 2026 00:12:23 +0300
Subject: [PATCH] ctype/toUptoLow: faster conversion for ascii bytes

---
 include/linux/ctype.h    | 10 ++++------
 lib/ctype.c              | 40 ++++++++++++++++++++++++++++++++++++++++
 lib/tests/string_kunit.c | 25 +++++++++++++++++++++++++
 3 files changed, 69 insertions(+), 6 deletions(-)

diff --git a/include/linux/ctype.h b/include/linux/ctype.h
index bc95aef22..d4825b881 100644
--- a/include/linux/ctype.h
+++ b/include/linux/ctype.h
@@ -19,6 +19,8 @@
 #define _SP	0x80	/* hard space (0x20) */
 
 extern const unsigned char _ctype[];
+extern const unsigned char __tolower_table[256];
+extern const unsigned char __toupper_table[256];
 
 #define __ismask(x) (_ctype[(int)(unsigned char)(x)])
 
@@ -48,16 +50,12 @@ static inline int isdigit(int c)
 
 static inline unsigned char __tolower(unsigned char c)
 {
-	if (isupper(c))
-		c -= 'A'-'a';
-	return c;
+	return __tolower_table[c];
 }
 
 static inline unsigned char __toupper(unsigned char c)
 {
-	if (islower(c))
-		c -= 'a'-'A';
-	return c;
+	return __toupper_table[c];
 }
 
 #define tolower(c) __tolower(c)
