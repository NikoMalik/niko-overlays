diff --git a/lib/tests/string_kunit.c b/lib/tests/string_kunit.c
index 0819ace5b..6dc61ede8 100644
--- a/lib/tests/string_kunit.c
+++ b/lib/tests/string_kunit.c
@@ -6,7 +6,9 @@
 #define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
 
 #include <kunit/test.h>
+#include <linux/ctype.h>
 #include <linux/ktime.h>
+#include <linux/limits.h>
 #include <linux/math64.h>
 #include <linux/minmax.h>
 #include <linux/mm.h>
@@ -31,6 +33,28 @@
 #define STRING_BENCH_SEED	888
 #define STRING_BENCH_WORKLOAD	(1 * MEGA)
 
+static void string_test_ctype_case_conversion(struct kunit *test)
+{
+	unsigned int c;
+	unsigned char expected;
+
+	for (c = 0; c <= U8_MAX; c++) {
+		expected = c;
+		if ((c >= 'A' && c <= 'Z') ||
+		    (c >= 0xc0 && c <= 0xde && c != 0xd7))
+			expected += 'a' - 'A';
+		KUNIT_EXPECT_EQ_MSG(test, tolower(c), expected,
+				   "tolower(0x%02x)", c);
+
+		expected = c;
+		if ((c >= 'a' && c <= 'z') ||
+		    (c >= 0xdf && c <= 0xff && c != 0xf7))
+			expected -= 'a' - 'A';
+		KUNIT_EXPECT_EQ_MSG(test, toupper(c), expected,
+				   "toupper(0x%02x)", c);
+	}
+}
+
 static void string_test_memset16(struct kunit *test)
 {
 	unsigned i, j, k;
@@ -882,6 +906,7 @@ static void string_bench_strrchr(struct kunit *test)
 }
 
 static struct kunit_case string_test_cases[] = {
