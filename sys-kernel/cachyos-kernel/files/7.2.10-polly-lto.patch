From 845d81510737cbe579fbc6eb64de2090f724e41f Mon Sep 17 00:00:00 2001
From: NikoMalik <NikoMalik@users.noreply.github.com>
Date: Wed, 11 Nov 2026 01:29:03 +0300
Subject: [PATCH] kbuild: run polly in the thinlto link step too

with lto the compile step only emits bitcode and the loop passes run
inside ld.lld, so polly flags in KBUILD_CFLAGS do nothing. load the
plugin and pass the same options to the linker
---
 Makefile | 33 ++++++++++++++++++++++-----------
 1 file changed, 22 insertions(+), 11 deletions(-)

diff --git a/Makefile b/Makefile
index 9dd2272a93e35..256ae86cc2ea2 100644
--- a/Makefile
+++ b/Makefile
@@ -960,23 +960,34 @@ KBUILD_RUSTFLAGS += -Cdebug-assertions=$(if $(CONFIG_RUST_DEBUG_ASSERTIONS),y,n)
 KBUILD_RUSTFLAGS += -Coverflow-checks=$(if $(CONFIG_RUST_OVERFLOW_CHECKS),y,n)
 
 ifdef CONFIG_POLLY_CLANG
-KBUILD_CFLAGS	+= -fplugin=LLVMPolly.so \
-		   -mllvm -polly \
-		   -mllvm -polly-ast-use-context \
-		   -mllvm -polly-invariant-load-hoisting \
-		   -mllvm -polly-loopfusion-greedy \
-		   -mllvm -polly-run-inliner \
-                   -mllvm -polly-dependences-computeout=50000000 \
-		   -mllvm -polly-vectorizer=stripmine \
-                   -mllvm -polly-omp-backend=LLVM \
-                   -mllvm -polly-detect-profitability-min-per-loop-insts=40
+POLLY_OPTS := -polly \
+	      -polly-ast-use-context \
+	      -polly-invariant-load-hoisting \
+	      -polly-loopfusion-greedy \
+	      -polly-run-inliner \
+	      -polly-dependences-computeout=50000000 \
+	      -polly-vectorizer=stripmine \
+	      -polly-omp-backend=LLVM \
+	      -polly-detect-profitability-min-per-loop-insts=40
 
 # Polly may optimise loops with dead paths beyound what the linker
 # can understand. This may negate the effect of the linker's DCE
 # so we tell Polly to perfom proven DCE on the loops it optimises
 # in order to preserve the overall effect of the linker's DCE.
 ifdef CONFIG_LD_DEAD_CODE_DATA_ELIMINATION
-KBUILD_CFLAGS	+= -mllvm -polly-run-dce
+POLLY_OPTS += -polly-run-dce
+endif
+
+KBUILD_CFLAGS	+= -fplugin=LLVMPolly.so $(foreach o,$(POLLY_OPTS),-mllvm $(o))
+
+# With LTO the compile step only emits bitcode and the loop passes run
+# later inside the linker, so Polly never sees the code unless ld.lld
+# loads it too. --load-pass-plugin registers the pass, -mllvm -load
+# registers its options so the -polly flags below are accepted.
+ifdef CONFIG_LTO_CLANG
+KBUILD_LDFLAGS	+= $(call ld-option,--load-pass-plugin=LLVMPolly.so \
+		   -mllvm -load=LLVMPolly.so \
+		   $(foreach o,$(POLLY_OPTS),-mllvm $(o)))
 endif
 endif
 
-- 
2.56.0

