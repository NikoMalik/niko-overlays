diff --git a/mm/page_alloc.c b/mm/page_alloc.c
index e822f7cc8..40cc3b7b6 100644
--- a/mm/page_alloc.c
+++ b/mm/page_alloc.c
@@ -6040,11 +6040,11 @@ static int zone_batchsize(struct zone *zone)
 
 	/*
 	 * The number of pages to batch allocate is either ~0.025%
-	 * of the zone or 256KB, whichever is smaller. The batch
+	 * of the zone or 2MB, whichever is smaller. The batch
 	 * size is striking a balance between allocation latency
 	 * and zone lock contention.
 	 */
-	batch = min(zone_managed_pages(zone) >> 12, SZ_256K / PAGE_SIZE);
+	batch = min(zone_managed_pages(zone) >> 12, 2 * SZ_1M / PAGE_SIZE);
 	if (batch <= 1)
 		return 1;
 

